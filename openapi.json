      "post": {
        "operationId": "createDevice",
        "tags": [
          "People"
        ],
        "summary": "Add a device",
        "description": "Issues a certificate and a fixed VPN address, and returns the client config with the device's private key. The key is not stored: this is the only time it is shown.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Person id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewDevice"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The device and its client config.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewDeviceResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
