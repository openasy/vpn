        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Ready to serve.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "tags": [
          "Product"
        ],
        "summary": "Prometheus metrics",
        "responses": {
          "200": {
            "description": "Metrics in the Prometheus text format.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serverToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`VPN_SERVER_TOKEN`, shared with vpn-server agents."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`VPN_ADMIN_TOKEN`, until sign-in exists (ADR 0002)."
      }
    },
    "responses": {
      "Problem": {
        "description": "The request was refused. `code` is stable; `detail` says what to do.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "vpn-manager"
          },
          "version": {
            "type": "string",
            "description": "SemVer of this release.",
            "examples": [
              "0.1.0"
            ]
          }
        }
      },
      "Server": {
        "type": "object",
        "required": [
          "id",
          "version",
          "listen",
          "openvpnRunning",
          "lastSeen",
          "configVersion"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ServerId"
          },
          "version": {
            "type": "string",
            "examples": [
              "0.1.0"
            ]
          },
          "listen": {
            "$ref": "#/components/schemas/Listen"
          },
          "openvpnRunning": {
            "type": "boolean"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          },
          "configVersion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Version of the config the agent applies; compare with GET /api/v1/servers/{id}/config."
          }
        }
      },
      "ServerList": {
        "type": "object",
        "required": [
          "servers"
        ],
        "properties": {
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Server"
            }
          }
        }
      },
      "ServerId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
        "description": "Lowercase letters, digits and dashes.",
        "examples": [
          "edge-1"
        ]
      },
      "Listen": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^(udp|tcp)/\\d{1,5}$",
        "description": "Protocol and port the server listens on; null when its config file decides.",
        "examples": [
          "udp/1194",
          "tcp/443"
        ]
      },
      "Heartbeat": {
        "type": "object",
        "required": [
          "id",
          "version",
          "openvpnRunning"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ServerId"
          },
          "version": {
            "type": "string",
            "examples": [
              "0.1.0"
            ]
          },
          "listen": {
            "$ref": "#/components/schemas/Listen"
          },
          "openvpnRunning": {
            "type": "boolean"
          },
          "configVersion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Version of the config the agent applied."
          },
          "sessions": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/ReportedSession"
            },
            "description": "Connected devices, from OpenVPN's management interface."
          }
        }
      },
      "Accepted": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "examples": [
              "ok",
              "ready"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "examples": [
              "https://openasy.github.io/problems/version-mismatch"
            ]
          },
          "title": {
            "type": "string",
            "examples": [
              "Version mismatch"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "examples": [
              "vpn-server 0.0.9 does not match vpn-manager 0.1.0; install vpn-server 0.1.0"
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable identifier to match on in code.",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "version-mismatch",
              "not-found",
              "conflict",
              "not-configured",
              "internal-error"
            ]
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "status",
          "groups",
          "devices",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque id.",
            "examples": [
              "3f2b8c1e-5d4a-4f6b-9c2e-7a1d0e9b8f64"
            ]
          },
          "name": {
            "type": "string",
            "examples": [
              "Dana Kim"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "examples": [
              "dana@example.com"
            ]
          },
          "status": {
            "enum": [
              "active",
              "suspended"
            ]
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group names."
          },
          "devices": {
            "type": "integer",
            "description": "Devices that are not revoked."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PersonList": {
        "type": "object",
        "required": [
          "people"
        ],
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          }
        }
      },
      "NewPerson": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group names."
          }
        }
      },
      "PersonChange": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "suspended"
            ]
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group names."
          }
        }
      },
      "Device": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "name",
          "vpnIp",
          "notAfter",
          "createdAt",
          "revokedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque id; also the certificate's common name.",
            "examples": [
              "3f2b8c1e-5d4a-4f6b-9c2e-7a1d0e9b8f64"
            ]
          },
          "personId": {
            "type": "string",
            "description": "Opaque id.",
            "examples": [
              "3f2b8c1e-5d4a-4f6b-9c2e-7a1d0e9b8f64"
            ]
          },
          "name": {
            "type": "string",
            "examples": [
              "Work laptop"
            ]
          },
          "vpnIp": {
            "type": "string",
            "format": "ipv4",
            "examples": [
              "10.8.0.2"
            ]
          },
          "notAfter": {
            "type": "string",
            "format": "date-time",
            "description": "When the certificate expires."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "DeviceList": {
        "type": "object",
        "required": [
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          }
        }
      },
      "NewDevice": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "examples": [
              "Work laptop"
            ]
          }
        }
      },
      "NewDeviceResult": {
        "type": "object",
        "required": [
          "device",
          "ovpn"
        ],
        "properties": {
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "ovpn": {
            "type": "string",
            "description": "OpenVPN client config with the private key. Save it as a .ovpn file; it is not shown again."
          }
        }
      },
      "Group": {
        "type": "object",
        "required": [
          "id",
          "name",
          "people"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque id.",
            "examples": [
              "3f2b8c1e-5d4a-4f6b-9c2e-7a1d0e9b8f64"
            ]
          },
          "name": {
            "type": "string",
            "examples": [
              "Backend engineers"
            ]
          },
          "people": {
            "type": "integer"
          }
        }
      },
      "GroupList": {
        "type": "object",
        "required": [
          "groups"
        ],
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Group"
            }
          }
        }
      },
      "NewGroup": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          }
        }
      },
      "IpNetwork": {
        "type": "object",
        "required": [
          "cidr",
          "ports",
          "note"
        ],
        "properties": {
          "cidr": {
            "type": "string",
            "description": "IPv4 network with host bits zero.",
            "examples": [
              "172.16.20.0/24"
            ]
          },
          "ports": {
            "type": "string",
            "description": "Ports the server lets members reach; everything else is dropped. `any` allows every port.",
            "examples": [
              "tcp/5432, 6432",
              "any"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "IpGroup": {
        "type": "object",
        "required": [
          "id",
          "name",
          "fullTunnel",
          "networks",
          "allowedGroups"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque id.",
            "examples": [
              "3f2b8c1e-5d4a-4f6b-9c2e-7a1d0e9b8f64"
            ]
          },
          "name": {
            "type": "string",
            "examples": [
              "Production databases"
            ]
          },
          "fullTunnel": {
            "type": "boolean",
            "description": "Send all of a member's traffic through the VPN. Where it may go is still set by the networks; add 0.0.0.0/0 to allow the internet."
          },
          "networks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IpNetwork"
            }
          },
          "allowedGroups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group names."
          }
        }
      },
      "IpGroupList": {
        "type": "object",
        "required": [
          "ipGroups"
        ],
        "properties": {
          "ipGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IpGroup"
            }
          }
        }
      },
      "NewIpGroup": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "fullTunnel": {
            "type": "boolean"
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cidr"
              ],
              "properties": {
                "cidr": {
                  "type": "string"
                },
                "ports": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "allowedGroups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group names."
          }
        }
      },
      "IpGroupChange": {
        "type": "object",
        "properties": {
          "fullTunnel": {
            "type": "boolean"
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cidr"
              ],
              "properties": {
                "cidr": {
                  "type": "string"
                },
                "ports": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "allowedGroups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group names."
          }
        }
      },
      "ServerConfig": {
        "type": "object",
        "required": [
          "version",
          "network",
          "ca",
          "cert",
          "key",
          "crl",
          "tlsCrypt",
          "clients"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "Changes whenever anything below changes."
          },
          "network": {
            "type": "string",
            "examples": [
              "10.8.0.0/24"
            ]
          },
          "ca": {
            "type": "string",
            "description": "CA certificate, PEM."
          },
          "cert": {
            "type": "string",
            "description": "This server's certificate, PEM."
          },
          "key": {
            "type": "string",
            "description": "This server's private key, PEM."
          },
          "crl": {
            "type": "string",
            "description": "Revocation list, PEM."
          },
          "tlsCrypt": {
            "type": "string",
            "description": "OpenVPN tls-crypt key."
          },
          "clients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cn",
                "ip",
                "routes",
                "fullTunnel",
                "allow"
              ],
              "properties": {
                "cn": {
                  "type": "string",
                  "description": "Device id, the certificate's common name."
                },
                "ip": {
                  "type": "string",
                  "format": "ipv4"
                },
                "routes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Networks pushed to the client."
                },
                "fullTunnel": {
                  "type": "boolean"
                },
                "allow": {
                  "type": "array",
                  "description": "Firewall rules: where the device may go. Everything else from the device is dropped.",
                  "items": {
                    "$ref": "#/components/schemas/Allow"
                  }
                }
              }
            }
          }
        }
      },
      "HeartbeatAccepted": {
        "type": "object",
        "required": [
          "status",
          "disconnect"
        ],
        "properties": {
          "status": {
            "const": "accepted"
          },
          "disconnect": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Device ids whose sessions the server must end now."
          }
        }
      },
      "ReportedSession": {
        "type": "object",
        "required": [
          "cn",
          "realAddress",
          "vpnIp",
          "bytesIn",
          "bytesOut",
          "connectedAt"
        ],
        "properties": {
          "cn": {
            "type": "string",
            "maxLength": 64,
            "description": "Device id."
          },
          "realAddress": {
            "type": "string",
            "maxLength": 64,
            "examples": [
              "203.0.113.24:51820"
            ]
          },
          "vpnIp": {
            "type": "string",
            "format": "ipv4"
          },
          "bytesIn": {
            "type": "integer",
            "minimum": 0
          },
          "bytesOut": {
            "type": "integer",
            "minimum": 0
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "serverId",
          "deviceId",
          "deviceName",
          "personId",
          "personName",
          "realAddress",
          "vpnIp",
          "bytesIn",
          "bytesOut",
          "connectedAt"
        ],
        "properties": {
          "serverId": {
            "$ref": "#/components/schemas/ServerId"
          },
          "deviceId": {
            "type": "string"
          },
          "deviceName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null when the device was deleted while connected."
          },
          "personId": {
            "type": [
              "string",
              "null"
            ]
          },
          "personName": {
            "type": [
              "string",
              "null"
            ]
          },
          "realAddress": {
            "type": "string",
            "description": "Where the device connects from.",
            "examples": [
              "203.0.113.24:51820"
            ]
          },
          "vpnIp": {
            "type": "string",
            "format": "ipv4",
            "examples": [
              "10.8.0.2"
            ]
          },
          "bytesIn": {
            "type": "integer",
            "description": "Bytes the server received from the device."
          },
          "bytesOut": {
            "type": "integer",
            "description": "Bytes the server sent to the device."
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionList": {
        "type": "object",
        "required": [
          "sessions"
        ],
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          }
        }
      },
      "Allow": {
        "type": "object",
        "required": [
          "cidr",
          "proto",
          "ports"
        ],
        "properties": {
          "cidr": {
            "type": "string",
            "examples": [
              "172.16.20.0/24"
            ]
          },
          "proto": {
            "enum": [
              "tcp",
              "udp",
              "any"
            ]
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "description": "Empty: every port."
          }
        }
      }
    }
  }
}
