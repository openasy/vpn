    "/api/v1/servers": {
      "get": {
        "operationId": "listServers",
        "tags": [
          "Servers"
        ],
        "summary": "List VPN servers",
        "description": "Every vpn-server agent that has reported to this manager, with its last heartbeat.",
        "responses": {
          "200": {
            "description": "Known servers, ordered by id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ]
      }
    },
    "/api/v1/servers/heartbeat": {
      "post": {
        "operationId": "sendHeartbeat",
        "tags": [
          "Servers"
        ],
        "summary": "Report a server's state",
        "description": "Called by vpn-server every 15 seconds with its live sessions. The answer lists sessions to end now. The agent must have the same version as the manager (ADR 0019).",
        "security": [
          {
            "serverToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Heartbeat"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatAccepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/servers/{id}/config": {
      "get": {
        "operationId": "getServerConfig",
        "tags": [
          "Servers"
        ],
        "summary": "What a server must run",
        "description": "Pulled by vpn-server. Issues the server's certificate on first use. Send the last `ETag` in `If-None-Match` to get 304 when nothing changed. Contains the server's private key.",
        "security": [
          {
            "serverToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Server id, for example edge-1.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The desired state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerConfig"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "The config version, quoted."
              }
            }
          },
          "304": {
            "description": "Unchanged since the given ETag."
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
