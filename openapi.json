    "/api/v1/sessions/{server}/{device}": {
      "delete": {
        "operationId": "disconnectSession",
        "tags": [
          "Sessions"
        ],
        "summary": "Disconnect a session",
        "description": "The server ends it at its next heartbeat, within 15 seconds. A device that is still allowed may connect again; revoke it or suspend the person to keep it out.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "server",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Server id."
          },
          {
            "name": "device",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Device id."
          }
        ],
        "responses": {
          "202": {
            "description": "Will be disconnected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
