{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy VPN manager API",
    "version": "0.2.0",
    "summary": "Servers, users and access for OpenVPN.",
    "description": "Every screen of vpn-manager uses this API, and so can your scripts (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nUntil sign-in exists (ADR 0002), management endpoints take `VPN_ADMIN_TOKEN` as a bearer token and agents take `VPN_SERVER_TOKEN`. Use this release only for testing.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This vpn-manager"
    }
  ],
  "tags": [
    {
      "name": "People",
      "description": "People who use the VPN, and their devices."
    },
    {
      "name": "Access",
      "description": "Groups of people, and IP groups: the networks each group may reach."
    },
    {
      "name": "Sessions",
      "description": "Devices connected right now."
    },
    {
      "name": "Servers",
      "description": "OpenVPN servers run by vpn-server agents."
    },
    {
      "name": "Product",
      "description": "Version and health of this vpn-manager."
    }
  ],
  "paths": {
    "/api/v1/people": {
      "get": {
        "operationId": "listPeople",
        "tags": [
          "People"
        ],
        "summary": "List people",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Everyone, by name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createPerson",
        "tags": [
          "People"
        ],
        "summary": "Add a person",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPerson"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added, active.",
