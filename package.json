    "react-dom": "^19.3.1",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.0",
